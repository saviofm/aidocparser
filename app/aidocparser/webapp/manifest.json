{
  "_version": "1.65.0",
  "sap.app": {
    "id": "aidocparser",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "1.0.0" },
    "crossNavigation": {
      "inbounds": {
        "DocParser-upload": {
          "semanticObject": "DocParser",
          "action": "upload",
          "title": "{{flpTitleUpload}}",
          "subTitle": "{{flpSubtitleUpload}}",
          "icon": "sap-icon://upload-to-cloud",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        },
        "DocParser-browse": {
          "semanticObject": "DocParser",
          "action": "browse",
          "title": "{{flpTitleBrowse}}",
          "subTitle": "{{flpSubtitleBrowse}}",
          "icon": "sap-icon://documents",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true,
    "supportedThemes": ["sap_horizon"],
    "icons": { "icon": "sap-icon://upload-to-cloud" },
    "deviceTypes": { "desktop": true, "tablet": true, "phone": false }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.130.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.ui.unified": {},
        "sap.ui.table": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "aidocparser.i18n.i18n",
          "supportedLocales": ["en", "pt", "pt_BR"],
          "fallbackLocale": "en"
        }
      }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "rootView": {
      "viewName": "aidocparser.view.App",
      "type": "XML",
      "id": "appView"
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "aidocparser.view",
        "controlId": "appNav",
        "controlAggregation": "pages",
        "transition": "slide"
      },
      "routes": [
        { "name": "home",  "pattern": "",      "target": "home"  },
        { "name": "parse", "pattern": "parse", "target": "parse" }
      ],
      "targets": {
        "home":  { "viewName": "Home",  "viewId": "homeView",  "viewLevel": 1 },
        "parse": { "viewName": "Parse", "viewId": "parseView", "viewLevel": 2 }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.cloud": {
    "public": true,
    "service": "aidocparser"
  }
}
