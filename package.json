{
  "name": "aidocparser",
  "version": "1.0.0",
  "description": "AI Document Parser — central de administração de documentos no SAP BTP",
  "private": true,
  "workspaces": [
    "srv",
    "app/aidocparser"
  ],
  "scripts": {
    "install:all": "npm install && npm install --prefix srv && npm install --prefix app/aidocparser",
    "start:srv": "cds watch",
    "start:mcp": "node srv/mcp-server.js",
    "start:ui": "cd app/aidocparser && npm start",
    "build:backend": "npx cds build --production",
    "build:mta": "rimraf resources mta_archives && mbt build",
    "undeploy": "cf undeploy aidocparser --delete-services --delete-service-keys"
  },
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "[production]": {
          "kind": "hana"
        }
      },
      "auth": {
        "[development]": {
          "kind": "dummy"
        },
        "[production]": {
          "kind": "xsuaa"
        }
      }
    },
    "folders": {
      "db": "db/",
      "srv": "srv/"
    }
  },
  "devDependencies": {
    "@sap/cds-dk": "^8",
    "mbt": "^1.2",
    "rimraf": "^5",
    "sqlite3": "^6.0.1"
  }
}
