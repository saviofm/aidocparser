<mvc:View
  controllerName="aidocparser.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout"
  xmlns:f="sap.ui.layout.form"
  xmlns:u="sap.ui.unified"
  xmlns:core="sap.ui.core">

  <Page
    id="mainPage"
    title="AI Doc Parser"
    showHeader="true">

    <customHeader>
      <Bar>
        <contentLeft>
          <Title text="AI Doc Parser" level="H4" />
        </contentLeft>
        <contentRight>
          <Button
            icon="sap-icon://refresh"
            tooltip="Nova análise"
            press=".onReset"
            visible="{= ${app>/step} !== 'drop' }" />
        </contentRight>
      </Bar>
    </customHeader>

    <content>
      <!-- ── Busy overlay ──────────────────────────────────────────── -->
      <BusyIndicator
        id="globalBusy"
        visible="{app>/busy}"
        size="Large"
        class="sapUiMediumMarginTop"
        customIcon=""
        text="{app>/busyText}" />

      <!-- ── Error strip ───────────────────────────────────────────── -->
      <MessageStrip
        text="{app>/errorMessage}"
        type="Error"
        showIcon="true"
        showCloseButton="true"
        visible="{= !!${app>/errorMessage} }"
        close=".onCloseError"
        class="sapUiSmallMargin" />

      <!-- ════ STEP: drop ════════════════════════════════════════════ -->
      <VBox
        visible="{= ${app>/step} === 'drop' &amp;&amp; !${app>/busy} }"
        alignItems="Center"
        class="sapUiLargeMarginTop">

        <Panel
          width="600px"
          backgroundDesign="Solid"
          class="sapUiResponsivePadding">

          <content>
            <VBox alignItems="Center" class="sapUiMediumMarginTopBottom">
              <core:Icon
                src="sap-icon://upload-to-cloud"
                size="4rem"
                color="#01502D"
                class="sapUiSmallMarginBottom" />

              <Title text="Arraste o arquivo ou clique para selecionar" level="H4" class="sapUiSmallMarginBottom" />
              <Text text="PDF · Excel · Word · Imagens · máx 20 MB" class="sapUiTinyMarginBottom" />

              <u:FileUploader
                id="fileUploader"
                uploadUrl=""
                fileType="pdf,xlsx,xls,docx,doc,png,jpg,jpeg,webp,tiff,gif"
                maximumFileSize="20"
                change=".onFileSelected"
                buttonText="Selecionar arquivo"
                style="Emphasized"
                class="sapUiSmallMarginTop" />
            </VBox>
          </content>
        </Panel>
      </VBox>

      <!-- ════ STEP: parsing ═════════════════════════════════════════ -->
      <VBox
        visible="{= ${app>/step} === 'parsing' }"
        alignItems="Center"
        class="sapUiLargeMarginTop">

        <Panel width="600px" backgroundDesign="Solid" class="sapUiResponsivePadding">
          <content>
            <VBox alignItems="Center" class="sapUiMediumMarginTopBottom">
              <BusyIndicator size="Large" class="sapUiSmallMarginBottom" />
              <Title text="Analisando documento..." level="H5" class="sapUiSmallMarginBottom" />
              <Text text="{app>/parseProgress}" />
            </VBox>
          </content>
        </Panel>
      </VBox>

      <!-- ════ STEP: preview ═════════════════════════════════════════ -->
      <VBox
        visible="{= ${app>/step} === 'preview' }"
        class="sapUiSmallMargin">

        <!-- Badges de métricas -->
        <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
          <ObjectStatus
            title="Arquivo"
            text="{app>/fileName}"
            state="Information"
            class="sapUiSmallMarginEnd" />
          <ObjectStatus
            title="Páginas"
            text="{app>/pageCount}"
            state="None"
            class="sapUiSmallMarginEnd" />
          <ObjectStatus
            title="OCR"
            text="{= ${app>/hasOcr} ? 'Sim' : 'Não' }"
            state="{= ${app>/hasOcr} ? 'Warning' : 'Success' }"
            class="sapUiSmallMarginEnd" />
          <ObjectStatus
            title="Tokens usados"
            text="{app>/tokensUsed}"
            state="None" />
        </HBox>

        <!-- Preview do texto parseado -->
        <Panel
          headerText="Preview do conteúdo parseado"
          expandable="true"
          expanded="true"
          class="sapUiSmallMarginBottom">
          <content>
            <TextArea
              id="previewArea"
              value="{app>/parsedText}"
              rows="20"
              width="100%"
              editable="true" />
          </content>
        </Panel>

        <!-- Opções de upload -->
        <Panel headerText="Configurações de upload" class="sapUiSmallMarginBottom">
          <content>
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout" columnsL="2" columnsM="1">
              <f:content>

                <Label text="Destino do parseado" />
                <Select id="parsedDestSelect" change=".onParsedDestChange">
                  <items>
                    <core:Item key="sdm" text="SAP Document Management (SDM) — para Grounding RAG" />
                    <core:Item key="s3" text="SAP Object Store (S3) — armazenamento direto" />
                  </items>
                </Select>

                <!-- Folder Picker (só SDM) -->
                <Label text="Pasta no SDM" visible="{= ${app>/parsedDestination} === 'sdm' }" />
                <HBox visible="{= ${app>/parsedDestination} === 'sdm' }">
                  <Input
                    value="{app>/selectedFolderName}"
                    placeholder="Selecione a pasta de destino..."
                    editable="false"
                    width="300px"
                    class="sapUiSmallMarginEnd" />
                  <Button text="Escolher pasta" press=".onOpenFolderPicker" type="Ghost" />
                </HBox>

                <Label text="Versão a subir" />
                <RadioButtonGroup
                  id="uploadModeGroup"
                  columns="2"
                  select=".onUploadModeChange">
                  <RadioButton
                    id="rbParsed"
                    text="Versão processada (markdown) — recomendado"
                    selected="true" />
                  <RadioButton
                    id="rbRaw"
                    text="Arquivo original (sem processamento)" />
                </RadioButtonGroup>

              </f:content>
            </f:SimpleForm>

            <!-- Aviso -->
            <MessageStrip
              text="O arquivo no destino será a versão otimizada para busca, não o original. O original será sempre preservado no Object Store (S3)."
              type="Information"
              showIcon="true"
              class="sapUiSmallMargin"
              visible="{= ${app>/uploadMode} === 'parsed' }" />
          </content>
        </Panel>

        <!-- Ações -->
        <HBox justifyContent="End" class="sapUiSmallMarginBottom">
          <Button text="Nova análise" press=".onReset" type="Ghost" class="sapUiSmallMarginEnd" />
          <Button
            text="Confirmar Upload"
            press=".onUpload"
            type="Emphasized"
            enabled="{= ${app>/parsedDestination} !== 'sdm' || !!${app>/selectedFolderId} }" />
        </HBox>
      </VBox>

      <!-- ════ STEP: done ════════════════════════════════════════════ -->
      <VBox
        visible="{= ${app>/step} === 'done' }"
        alignItems="Center"
        class="sapUiLargeMarginTop">

        <Panel width="600px" backgroundDesign="Solid" class="sapUiResponsivePadding">
          <content>
            <VBox alignItems="Center" class="sapUiMediumMarginTopBottom">
              <core:Icon src="sap-icon://accept" size="3rem" color="Positive" class="sapUiSmallMarginBottom" />
              <Title text="Upload concluído!" level="H4" class="sapUiTinyMarginBottom" />
              <Text text="{app>/doneMessage}" class="sapUiSmallMarginBottom" />

              <!-- Link para original S3 -->
              <Link
                text="Baixar arquivo original"
                href="{app>/originalPresignedUrl}"
                target="_blank"
                visible="{= !!${app>/originalPresignedUrl} }"
                class="sapUiSmallMarginBottom" />

              <Button text="Fazer outro upload" press=".onReset" type="Emphasized" class="sapUiSmallMarginTop" />
            </VBox>
          </content>
        </Panel>
      </VBox>

    </content>
  </Page>

  <!-- ── Folder Picker Dialog ─────────────────────────────────────── -->
  <core:Fragment fragmentName="aidocparser.view.FolderPickerDialog" type="XML" />

</mvc:View>
